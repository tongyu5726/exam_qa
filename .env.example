# ── 对话 LLM（OpenAI 兼容；推荐在设置页注册并选择）────────
# LLM_PROVIDER 对应 data/llm_providers.json 里的 name
LLM_PROVIDER=default
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# 深度推理模型的推理与正文共享此预算；正文为空时可提高到 8192
LLM_MAX_TOKENS=4096

# ── Embedding（向量化，与 LLM 独立配置）──────────────────────
# provider: local（本地 sentence-transformers）| openai（OpenAI 兼容 API）
EMBEDDING_PROVIDER=local
# 须用完整 Hub ID（短名 all-MiniLM-L6-v2 不是独立仓库）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto：有可用 CUDA/MPS 就使用，否则 CPU；也可填 cpu / cuda / cuda:0 / mps
EMBEDDING_DEVICE=auto
# 国内拉模型慢/超时可开镜像（仅影响 HuggingFace 下载）：
# HF_ENDPOINT=https://hf-mirror.com
# 中文资料可改：BAAI/bge-small-zh-v1.5
# 以下留空则回退使用 LLM_API_KEY / LLM_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT=60

# 使用远程 Embedding API 示例：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── 检索 ──────────────────────────────────────────────────
# top_k：每次问答从资料库召回的最相似片段数（再经阈值过滤后送给 LLM）
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
# 精排（BGE CrossEncoder）：默认关；开启后宽池召回再精排，阈值作用于 sigmoid(logit)
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto
RERANK_CANDIDATES=20
# 0 表示与 RETRIEVAL_TOP_K 相同
RERANK_TOP_N=0
CHUNK_SIZE=800
CHUNK_OVERLAP=50

# ── Storage ────────────────────────────────────────────────
CHROMA_PATH=./storage/chroma
SQLITE_PATH=./storage/meta.db
LOG_PATH=./storage/app.log
KNOWLEDGE_DIR=data/knowledge
# MinerU / MarkPDFdown 导出的页面图片持久化目录，视觉摘要在入库阶段从这里读取
PARSED_ASSETS_DIR=storage/parsed_assets

# ── API ────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── App ────────────────────────────────────────────────────
PORT=8787
MAX_UPLOAD_MB=50
DEBUG=false
# 控制台/文件日志：DEBUG | INFO | WARNING | ERROR（设置页可改，立即生效）
LOG_LEVEL=INFO

# ── 网络代理（LLM / Embedding API / Hugging Face 下载）──────
# 留空表示不走代理；示例：http://127.0.0.1:7890
# 注意：PROXY_ENABLED=true 时须保证代理软件已启动，否则本地模型拉取会 WinError 10061。
# 使用 HF_ENDPOINT 国内镜像时，若代理未开，应用会自动直连重试一次。
PROXY_URL=
PROXY_ENABLED=false
NO_PROXY=127.0.0.1,localhost

# ── 文档解析 ───────────────────────────────────────────────
# PDF OCR：扫描版 PDF 自动识别（需系统安装 Tesseract 及语言包）
PDF_USE_OCR=true
PDF_FORCE_OCR=false
PDF_OCR_LANGUAGE=eng+chi_sim
# PDF 解析器：mineru（MinerU 结构解析，默认）| markpdfdown（外部增强适配器）| pymupdf（基础链路）| auto（原生文本直提，扫描件自动用增强解析器）
# MinerU 需外部安装（如 uv tool install mineru），首次运行自动下载模型（约 1-2GB）
PDF_PARSER=mineru
MINERU_CMD=mineru
# MinerU 超时秒数，0 表示不限时；默认 1800s 兜底，避免异常 CLI 无限挂起
MINERU_TIMEOUT=1800
# MinerU hybrid-engine：medium 速度较好；high 识别图表/复杂版式更强但更慢
MINERU_BACKEND=hybrid-engine
MINERU_EFFORT=medium
MINERU_LANG=ch
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_IMAGE_ANALYSIS=true
# 首轮质量低于阈值时自动用 MinerU high 重试；最终只保留质量更高的结果
MINERU_RETRY_HIGH=true
PDF_QUALITY_THRESHOLD=0.55
# 全文公式识别补偿（PaddleOCR）：结构化解析未给出公式时，对整份 PDF 识别公式区域并生成 LaTeX。
# 首次调用会下载模型，CPU 较慢；确认安装 PaddleOCR/PaddlePaddle 后再启用。
FORMULA_RECOGNITION_ENABLED=false
# 根据 Paddle 自身运行时检测 GPU（与 Torch 独立）；也可指定 cpu / gpu / gpu:0
FORMULA_RECOGNITION_DEVICE=auto
FORMULA_RECOGNITION_MODEL=PP-FormulaNet_plus-M
FORMULA_RECOGNITION_ENABLE_MKLDNN=false
FORMULA_RECOGNITION_TIMEOUT=1800
# 可选 MarkPDFdown 外部增强适配器：默认关闭，不会猜测第三方 CLI。
# 启用后须提供已验证的命令和参数模板；模板必须包含 {input} 和
# {output}（临时目录）或 {output_file}（临时 Markdown 文件）。
# MarkPDFdown 1.1.2 的已验证命令：
# MARKPDFDOWN_ENABLED=true
# MARKPDFDOWN_CMD=markpdfdown
# MARKPDFDOWN_ARGS=--input "{input}" --output "{output_file}"
MARKPDFDOWN_ENABLED=false
MARKPDFDOWN_CMD=
MARKPDFDOWN_ARGS=
MARKPDFDOWN_TIMEOUT=1800
# 多模态视觉理解（图表/图片摘要）：空 = 关闭；OpenAI 兼容视觉模型，如 qwen-vl-max / gpt-4o
# 未配置时图片只保留说明文本，不生成视觉摘要
VISUAL_MODEL=
VISUAL_BASE_URL=
VISUAL_API_KEY=
VISUAL_TIMEOUT=60
# PyMuPDF OCR 语言包目录（须为纯英文路径，内含 eng/chi_sim 等 .traineddata；留空则自动探测 PATH 中的 Tesseract）
TESSDATA_PREFIX=
